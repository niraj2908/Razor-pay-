// Revenue Recovery Intelligence — Domain Schema
// Implements the 18 entities listed in Section 24 of the master specification.
// Layering follows Section 25 (Intelligence / Policy / Execution):
//   Intelligence -> ModelPrediction
//   Policy       -> RevenueRiskEvent, CandidateAction, Decision, DecisionEvidence, MerchantPolicy
//   Execution    -> Execution, Outcome
// Everything else (Merchant/Customer/Order/Payment/PaymentEvent) is shared reference data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Raw Razorpay-side payment lifecycle (Section 4/6: what Razorpay itself reports).
enum RazorpayPaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

// Our internal diagnosis of a revenue-risk event (Section 6, "Diagnose").
// Deliberately matches the exact categories named in the spec — nothing added.
enum RiskDiagnosis {
  CONFIRMED_FAILURE
  PENDING
  STATE_UNCERTAIN
  CUSTOMER_ABANDONMENT
  NETWORK_DEGRADATION
  OTHER_RECOVERABLE
}

// The four core decisions (Section 8) — exact.
enum RecoveryDecision {
  ACT
  WAIT
  STOP
  ESCALATE
}

// Named actions referenced throughout the spec (Section 32 UI signature,
// Section 6 "Execute"). Kept as a closed enum so the policy engine can never
// select an action that isn't a real, reviewed capability (Section 7 of the
// dev rules: "we won't let the model choose illegal actions").
enum ActionType {
  NONE
  RETRY_NOW
  RETRY_LATER
  PAYMENT_LINK
  PAYMENT_METHOD_CHANGE
  CUSTOMER_CONTACT
  HUMAN_ESCALATION
  STOP_RECOVERY
  // Phase 22 Step 3: capturing an authorized-but-uncaptured payment is a
  // distinct action from retrying a failed one - added instead of the
  // RETRY_NOW placeholder executionService.ts previously used for it.
  CAPTURE
}

enum ExperimentGroup {
  CONTROL
  TREATMENT
}

enum ExecutionStatus {
  PENDING
  SUCCEEDED
  FAILED
  // Phase 22 Step 3: a network timeout or unparseable response after an
  // external Razorpay call is NOT proof the operation failed - the request
  // may have gone through. AMBIGUOUS is a distinct terminal-for-now state:
  // never auto-retried, always routed to reconciliation/escalation. See
  // docs/decision-engine.md.
  AMBIGUOUS
}

// Section 18: every row that could be real-or-simulated must be able to say which.
enum DataSource {
  REAL_RAZORPAY_TEST_MODE
  SIMULATED
}

enum ActorType {
  SYSTEM
  LLM
  HUMAN
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

model Merchant {
  id                String   @id @default(cuid())
  name              String
  razorpayAccountId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customers        Customer[]
  orders           Order[]
  payments         Payment[]
  revenueRiskEvents RevenueRiskEvent[]
  policies         MerchantPolicy[]
  networkEvents    NetworkEvent[]
  auditEvents      AuditEvent[]

  @@map("merchants")
}

model Customer {
  id                  String   @id @default(cuid())
  merchantId          String
  razorpayCustomerId  String?
  email               String?
  phone               String?
  createdAt           DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders   Order[]
  payments Payment[]

  @@unique([merchantId, razorpayCustomerId])
  @@index([merchantId])
  @@map("customers")
}

model Order {
  id             String   @id @default(cuid())
  merchantId     String
  customerId     String?
  razorpayOrderId String  @unique
  amount         Int      // paise — never store money as float
  currency       String   @default("INR")
  status         String
  createdAt      DateTime @default(now())

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([merchantId])
  @@map("orders")
}

model Payment {
  id                String                @id @default(cuid())
  merchantId        String
  orderId           String?
  customerId        String?
  razorpayPaymentId String?               @unique
  amount            Int                   // paise
  currency          String                @default("INR")
  method            String?
  status            RazorpayPaymentStatus @default(CREATED)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  merchant          Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order             Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentEvents     PaymentEvent[]
  revenueRiskEvents RevenueRiskEvent[]
  executions        Execution[] @relation("ExecutionOriginalPayment")
  recoveredByExecution Execution? @relation("ExecutionRecoveredPayment")
  outcomes          Outcome[]

  @@index([merchantId])
  @@index([status])
  @@map("payments")
}

// Raw webhook log — Section 27/28: idempotency is enforced at this table via
// the unique constraint on razorpayEventId. Nothing downstream re-processes
// an event whose id has already landed here.
model PaymentEvent {
  id              String    @id @default(cuid())
  paymentId       String?
  razorpayEventId String    @unique
  eventType       String    // e.g. "payment.failed", "payment.captured"
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  // Phase 23 Step 2: PaymentEvent already provides the raw-event evidence
  // boundary - Outcome references it directly instead of a new raw-event
  // table (see docs/decision-engine.md).
  evidenceForOutcomes Outcome[]

  @@index([eventType])
  @@index([receivedAt])
  @@map("payment_events")
}

// ---------------------------------------------------------------------------
// Policy layer — the core unit of intelligence (Section 7)
// ---------------------------------------------------------------------------

model RevenueRiskEvent {
  id                        String        @id @default(cuid())
  merchantId                String
  paymentId                 String
  diagnosis                 RiskDiagnosis
  amountAtRisk              Int           // paise
  naturalRecoveryProbability Float?       // Model A output, nullable until scored
  detectedAt                DateTime      @default(now())
  resolvedAt                DateTime?
  dataSource                DataSource    @default(SIMULATED)
  // Phase 23 Step 2: nullable many-to-one, not a unique 1:1 back-relation -
  // a CUSTOMER-unit assignment (see ExperimentAssignment) is deliberately
  // reused across every recovery candidate for that same customer while an
  // experiment is running, so multiple RevenueRiskEvents may point at the
  // same assignment. A CANDIDATE-unit assignment still ends up 1:1 in
  // practice, just not enforced as such at the schema level.
  experimentAssignmentId    String?

  merchant          Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment           Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  candidateActions  CandidateAction[]
  decisions         Decision[]
  modelPredictions  ModelPrediction[]
  experimentAssignment ExperimentAssignment? @relation(fields: [experimentAssignmentId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([diagnosis])
  @@index([resolvedAt])
  @@index([experimentAssignmentId])
  @@map("revenue_risk_events")
}

// The generated action set for a given risk event (Section 6 "Predict" / "Decide").
model CandidateAction {
  id                          String     @id @default(cuid())
  revenueRiskEventId          String
  actionType                  ActionType
  predictedSuccessProbability Float
  incrementalLift             Float      // predictedSuccessProbability - naturalRecoveryProbability
  estimatedCost               Float      @default(0)
  expectedNetValue            Float
  createdAt                   DateTime   @default(now())

  revenueRiskEvent RevenueRiskEvent @relation(fields: [revenueRiskEventId], references: [id], onDelete: Cascade)
  chosenByDecisions Decision[]

  @@index([revenueRiskEventId])
  @@map("candidate_actions")
}

model Decision {
  id                      String           @id @default(cuid())
  revenueRiskEventId      String
  decisionType             RecoveryDecision
  chosenActionId           String?
  expectedIncrementalValue Float?
  decidedAt                DateTime         @default(now())

  revenueRiskEvent RevenueRiskEvent @relation(fields: [revenueRiskEventId], references: [id], onDelete: Cascade)
  chosenAction     CandidateAction? @relation(fields: [chosenActionId], references: [id], onDelete: SetNull)
  evidence         DecisionEvidence[]
  executions       Execution[]
  outcome          Outcome?

  @@index([revenueRiskEventId])
  @@index([decisionType])
  @@map("decisions")
}

// The "WHY" panel from Section 32 — every check/probability that fed the decision,
// stored explicitly so the decision is inspectable, not magical.
model DecisionEvidence {
  id           String   @id @default(cuid())
  decisionId   String
  evidenceType String   // e.g. "natural_recovery_probability", "safety_check", "policy_check"
  label        String   // e.g. "Payment state confirmed"
  value        String?  // stringified probability/amount where applicable
  passed       Boolean? // for safety/policy checks specifically; null for informational rows
  createdAt    DateTime @default(now())

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@map("decision_evidence")
}

model MerchantPolicy {
  id         String   @id @default(cuid())
  merchantId String
  ruleType   String   // e.g. "max_action_amount", "no_auto_payment_link_above"
  config     Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("merchant_policies")
}

// ---------------------------------------------------------------------------
// Execution layer
// ---------------------------------------------------------------------------

// Execution.decisionId is @unique (Phase 22 Step 2): at most one Execution
// per Decision row, enforced at the database level so that two concurrent
// "execute this decision" requests can never create two Execution rows -
// the second insert fails with P2002, exactly like PaymentEvent's
// razorpayEventId idempotency (see webhooks/idempotency.ts).
model Execution {
  id                  String          @id @default(cuid())
  decisionId          String          @unique
  paymentId           String          // the ORIGINAL payment being recovered
  actionType          ActionType
  razorpayReferenceId String?         // e.g. Payment Link id
  status              ExecutionStatus @default(PENDING)
  executedAt          DateTime        @default(now())
  completedAt         DateTime?
  // Phase 23 Step 3: the NEW internal Payment created once a Payment Link
  // this execution issued is paid (payment_link.paid) - a genuinely
  // different Razorpay payment object than `paymentId` above, never a
  // rewrite of it. Null until (and unless) that happens. Two separate
  // named relations to Payment are required since this model now
  // references Payment twice for two distinct roles.
  recoveredPaymentId  String?         @unique

  decision         Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  payment          Payment  @relation("ExecutionOriginalPayment", fields: [paymentId], references: [id], onDelete: Cascade)
  recoveredPayment Payment? @relation("ExecutionRecoveredPayment", fields: [recoveredPaymentId], references: [id], onDelete: SetNull)
  outcome          Outcome?

  @@index([status])
  @@map("executions")
}

// Phase 23 Step 2: has this payment resolved yet, and if it recovered, why?
// These are deliberately two separate questions (see docs/decision-engine.md):
// OutcomeStatus is the plain fact of what happened; AttributionStatus (only
// ever set once status=RECOVERED) is the causal explanation. Collapsing
// them into one enum would force a redundant FAILED-vs-NOT_RECOVERED
// distinction with no added meaning.
enum OutcomeStatus {
  PENDING       // attribution window still open - not yet resolved
  RECOVERED     // payment succeeded within the window
  NOT_RECOVERED // window closed with no success
}

// Evidence required for each value (Phase 23 Step 1 audit, Step 2 report):
//   NATURAL_RECOVERY      - status=RECOVERED and executionId is null: no
//                            intervention was ever executed for this
//                            decision (CONTROL arm, or a WAIT/STOP/ESCALATE
//                            decision), so recovery cannot be attributed to us.
//   INTERVENTION_RECOVERY - status=RECOVERED, executionId is set, and the
//                            evidence deterministically ties the recovering
//                            payment/event to that specific Execution (e.g.
//                            a payment_link.paid webhook whose payment_link
//                            id matches Execution.razorpayReferenceId).
//   UNKNOWN               - status=RECOVERED, executionId is set, but the
//                            evidence does not cleanly establish exclusive
//                            causation (e.g. the Execution itself resolved
//                            AMBIGUOUS, or correlating evidence is missing).
// ASSISTED was evaluated and deliberately NOT added in this step: its
// evidence criteria depend on Capture-specific ambiguity handling that
// isn't built yet (Phase 23 Step 1 audit, section 4/7). It can be added
// later as a single enum value, the same way ActionType.CAPTURE and
// ExecutionStatus.AMBIGUOUS were added incrementally in Phase 22.
enum AttributionStatus {
  NATURAL_RECOVERY
  INTERVENTION_RECOVERY
  UNKNOWN
}

// The minimum Outcome representation (Phase 23 Step 1 audit, section 3).
// References existing domain rows by ID rather than duplicating any
// payload - PaymentEvent already is the evidence boundary (section 10).
model Outcome {
  id                       String             @id @default(cuid())
  decisionId               String             @unique // one Outcome per Decision
  paymentId                String                       // the ORIGINAL payment being evaluated
  executionId              String?            @unique // null when no intervention was ever executed
  status                   OutcomeStatus      @default(PENDING)
  attributionStatus        AttributionStatus?           // set only once status=RECOVERED
  recoveredAmount          Int?                         // paise
  currency                 String             @default("INR")
  observedAt               DateTime           @default(now())
  // A version tag for the attribution policy in effect (e.g. "attribution-v1"),
  // NOT a hardcoded window baked into application logic - the actual window
  // (which may differ by strategy) is a later step's implementation detail;
  // this field only guarantees we can always identify which policy produced
  // a given historical Outcome. The relevant decision/intervention timestamps
  // are already reachable via the decision/execution relations, not duplicated here.
  attributionPolicyVersion String
  evidencePaymentEventId   String?                      // the webhook event that proves this outcome, if any
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  decision             Decision      @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  payment              Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  execution            Execution?    @relation(fields: [executionId], references: [id], onDelete: SetNull)
  evidencePaymentEvent PaymentEvent? @relation(fields: [evidencePaymentEventId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([status])
  @@map("outcomes")
}

// ---------------------------------------------------------------------------
// Experimentation (Section 12/16-19 of the original brainstorm — the
// counterfactual proof engine behind Proof 1 in Section 44)
// ---------------------------------------------------------------------------

enum ExperimentStatus {
  DRAFT
  RUNNING
  // Phase 23 Step 5: temporarily halts new assignments (e.g. investigating an
  // anomaly) without the finality of COMPLETED (which means "done, ready for
  // analysis," not "paused, may resume") and without a boolean flag hack
  // layered on top of RUNNING - see docs/decision-engine.md. Pausing never
  // changes any existing participant's arm; it only stops NEW assignments.
  PAUSED
  COMPLETED
}

model Experiment {
  id          String           @id @default(cuid())
  name        String
  version     String           // e.g. "v1" - same versioning convention as modelVersion/policyVersion
  hypothesis  String?          // what we expect and why, distinct from a general description
  description String?
  status      ExperimentStatus @default(DRAFT)
  // Percentage of eligible candidates actually sampled into this experiment
  // at all (the remainder is neither CONTROL nor TREATMENT - simply excluded).
  trafficAllocationPercent Int @default(100)
  // Phase 23 Step 5: of the candidates sampled into the experiment (above),
  // the percentage assigned to TREATMENT - the remainder is CONTROL by
  // construction. Modeled as a single field rather than separate
  // treatment/control percentages: representing CONTROL as "100 - treatment"
  // makes an invalid (non-100-summing) configuration structurally
  // impossible instead of merely something to validate. Required (no
  // default) because allocation must always be explicit, never silently
  // assumed - see assignmentEngine.ts. Changing this value for a running
  // experiment would silently reshuffle who is in which arm, so treat any
  // change as a new experiment (new `version`), never an in-place edit.
  treatmentAllocationPercent Int
  // Plain version/description tags, not JSON - CONTROL's meaning is a fixed
  // architectural invariant (no execution is ever allowed for it - Phase
  // 23 Step 1 section 8), so "no_intervention" is intentionally the default
  // rather than a configurable behavior.
  treatmentDefinition String
  controlDefinition   String    @default("no_intervention")
  startedAt   DateTime?         // null while status=DRAFT
  endedAt     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  assignments ExperimentAssignment[]
  results     ExperimentResult[]

  @@map("experiments")
}

enum AssignmentUnit {
  CUSTOMER  // preferred randomization unit when a stable Customer identity exists
  CANDIDATE // fallback unit for guest/anonymous payments (Phase 23 Step 1, section 9)
}

// Deterministic, auditable assignment (Phase 23 Step 1, section 7/9).
// unitKey holds a Customer.id when unitType=CUSTOMER, or a RevenueRiskEvent.id
// when unitType=CANDIDATE - kept as a plain string reference rather than two
// separate nullable FK columns, since exactly one of the two possible
// referents ever applies per row and the meaning is fully determined by
// unitType. The database-level unique constraint below (not a
// check-then-insert) is what actually prevents a double assignment.
model ExperimentAssignment {
  id                 String          @id @default(cuid())
  experimentId       String
  unitType           AssignmentUnit
  unitKey            String
  arm                ExperimentGroup
  assignedAt         DateTime        @default(now())
  // Version tag of the eligibility ruleset applied BEFORE randomization -
  // never recomputed after the fact (Phase 23 Step 1, section 8/10).
  eligibilityVersion String
  // Phase 23 Step 5: identifies the deterministic hashing strategy used to
  // compute `arm` (e.g. "sha256-v1") - see assignmentEngine.ts. Recorded so
  // the algorithm can evolve later (a new version string) without ever
  // reinterpreting or recomputing an existing assignment under a different
  // rule; a historical row's arm must remain exactly what it was computed
  // as, forever.
  assignmentAlgorithm String

  experiment        Experiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  // A CANDIDATE-unit assignment applies to exactly one RevenueRiskEvent in
  // practice; a CUSTOMER-unit assignment is deliberately reused across every
  // recovery candidate for that customer while this experiment runs - hence
  // one-to-many here, not one-to-one.
  revenueRiskEvents RevenueRiskEvent[]

  @@unique([experimentId, unitType, unitKey])
  @@index([experimentId])
  @@map("experiment_assignments")
}

// Aggregated per-group rollup. The incremental GMV number itself (Section 44,
// Proof 1) is a derived comparison across two rows here, computed in the
// reporting layer — not double-stored.
model ExperimentResult {
  id               String          @id @default(cuid())
  experimentId     String
  group            ExperimentGroup
  populationCount  Int
  totalAtRiskAmount Int            // paise
  totalRecoveredAmount Int         // paise
  interventionCount Int            @default(0)
  computedAt       DateTime        @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, group])
  @@map("experiment_results")
}

// ---------------------------------------------------------------------------
// Network intelligence (Section 7 "timing-sensitive", Section 26 diagram)
// ---------------------------------------------------------------------------

model NetworkEvent {
  id         String     @id @default(cuid())
  merchantId String?
  instrument String     // e.g. "UPI-HDFC", "card-network-visa"
  severity   String
  startedAt  DateTime
  endedAt    DateTime?
  source     DataSource @default(SIMULATED)
  createdAt  DateTime   @default(now())

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([instrument])
  @@index([startedAt])
  @@map("network_events")
}

// ---------------------------------------------------------------------------
// Intelligence layer logging (Section 24: model_predictions — reproducibility)
// ---------------------------------------------------------------------------

model ModelPrediction {
  id                  String   @id @default(cuid())
  revenueRiskEventId  String
  modelName           String   // e.g. "natural_recovery_v1"
  modelVersion        String
  predictedValue      Float
  inputFeatures       Json?
  predictedAt         DateTime @default(now())

  revenueRiskEvent RevenueRiskEvent @relation(fields: [revenueRiskEventId], references: [id], onDelete: Cascade)

  @@index([revenueRiskEventId])
  @@index([modelName, modelVersion])
  @@map("model_predictions")
}

// ---------------------------------------------------------------------------
// Audit (Section 24, Section 31 screen 6 — full action timeline)
// ---------------------------------------------------------------------------

model AuditEvent {
  id         String    @id @default(cuid())
  merchantId String?
  entityType String    // e.g. "Decision", "Execution", "MerchantPolicy"
  entityId   String
  action     String    // e.g. "decision.act", "policy.updated"
  actorType  ActorType @default(SYSTEM)
  details    Json?
  createdAt  DateTime  @default(now())

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}
